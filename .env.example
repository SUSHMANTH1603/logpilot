# ==============================================================================
# LogPilot Local Development Environment Configuration
# ==============================================================================
# SAFE PLACEHOLDER TEMPLATE: Never commit real credentials, production secrets,
# or live API keys to source control. Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# Application & Runtime
APP_ENV=development
APP_NAME=LogPilot
DEBUG=true
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars

# PostgreSQL System of Record (ADR-005)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=logpilot
POSTGRES_USER=logpilot
POSTGRES_PASSWORD=logpilot_dev_password
DATABASE_URL=postgresql+asyncpg://logpilot:logpilot_dev_password@127.0.0.1:5432/logpilot
DATABASE_SYNC_URL=postgresql+psycopg://logpilot:logpilot_dev_password@127.0.0.1:5432/logpilot

# Redis Infrastructure Layer - Queue & Ephemeral Cache (ADR-005)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379/0

# Qdrant Derived Vector Index (ADR-005)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Local LLM Gateway (ADR-002 - Abstract Provider Pattern)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Security & Redaction (D11 / ADR-006)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
